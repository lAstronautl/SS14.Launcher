<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Managed entry point of the game process. Runs inside the .NET runtime version the engine was built for
    (downloaded Mono runtime on Android, `dotnet exec \-\-fx-version` on desktop), so it targets the oldest
    framework we support and shares only net6-compatible source files with Robust.Launcher.Core.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RollForward>LatestMajor</RollForward>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="LoaderApiRef\**" />
    <None Remove="LoaderApiRef\**" />
    <Compile Include="..\Robust.Launcher.Core\EngineLoader.cs" Link="Shared\EngineLoader.cs" />
    <Compile Include="..\Robust.Launcher.Core\CompatShims.cs" Link="Shared\CompatShims.cs" />
    <Compile Include="..\Robust.Launcher.Core\ContentBundle.cs" Link="Shared\ContentBundle.cs" />
    <Compile Include="..\Robust.Launcher.Core\FileApis.cs" Link="Shared\FileApis.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="LoaderApiRef\Robust.LoaderApi.Ref.csproj" Private="false" />
  </ItemGroup>
</Project>
