<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Android app: launcher UI + a thin host that runs a *downloaded* engine build in a separate ":game" process.
    The engine (managed Robust.Client + Resources) is not bundled: EngineManager fetches the build matching the
    server's engine_version (ours from this repo's GitHub releases, or the official one in compatibility mode).
    The game process (Java GameActivity + native host libmain.so) runs it on a downloaded Mono runtime of the
    .NET version the engine was built for, so engines for any .NET version work (see natives/robust_host.c).
    Native libraries are built by natives/build-natives.sh into natives/out/<abi>/.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- The desktop launcher pins versions centrally; the Android app has its own SDK-implied packages. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationId>com.starhorizon.launcher</ApplicationId>
    <ApplicationTitle>StarHorizon</ApplicationTitle>
    <ApplicationVersion>15</ApplicationVersion>
    <ApplicationDisplayVersion>0.3.1</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RootNamespace>Robust.Client.Android</RootNamespace>

    <!-- The engine relies heavily on reflection, Reflection.Emit and runtime assembly loading:
         no trimming, no full AOT. -->
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseAssemblyStore>true</AndroidUseAssemblyStore>
    <NoWarn>$(NoWarn);XA4211;XA1006;CS0618;CA1416;CA1422;BG8A04;BG8A00;BG8102;BG8C01;BG8401;BG8605;BG8606</NoWarn>

    <NativesDir>$(MSBuildThisFileDirectory)natives/out/</NativesDir>
    <_DotnetCryptoJar>$(NetCoreTargetingPackRoot)/Microsoft.NETCore.App.Runtime.Mono.android-arm64/$(BundledNETCoreAppPackageVersion)/runtimes/android-arm64/native/libSystem.Security.Cryptography.Native.Android.jar</_DotnetCryptoJar>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Robust.LoaderApi\Robust.LoaderApi\Robust.LoaderApi.csproj" />
    <ProjectReference Include="..\Robust.Launcher.Core\Robust.Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDL3 Java side (SDLActivity etc.); GameActivity (Java) extends it. -->
    <!-- *.jar files are picked up (and bound) by default; we only need the Java classes packaged. -->
    <AndroidLibrary Remove="natives/**" />
    <AndroidLibrary Include="$(NativesDir)java/sdl3.jar" Bind="false" />
    <!-- Java side of .NET's Android crypto (TLS). The game process loads the native half from the downloaded
         runtime; these classes are the same in .NET 9 and 10 (8 uses a subset). -->
    <AndroidLibrary Include="$(_DotnetCryptoJar)" Bind="false" Condition="Exists('$(_DotnetCryptoJar)')" />
    <AndroidJavaSource Include="Java/**/*.java" />

    <AndroidNativeLibrary Include="$(NativesDir)arm64-v8a/*.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(NativesDir)x86_64/*.so" Abi="x86_64" />
  </ItemGroup>

  <!-- Managed entry point of the game process, extracted from assets at runtime. -->
  <Target Name="BuildGameHost" BeforeTargets="PrepareForBuild">
    <MSBuild Projects="..\Robust.Android.GameHost\Robust.Android.GameHost.csproj" Targets="Build"
             Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained;TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_GameHostDll" />
    </MSBuild>
    <ItemGroup>
      <AndroidAsset Include="@(_GameHostDll)" Link="Assets/gamehost/Robust.Android.GameHost.dll" />
    </ItemGroup>
  </Target>

  <!-- .NET for Android adds a runtime-init provider to every process in the manifest. The game process must not
       start the app's .NET runtime (the native host starts the engine's own one), so drop that provider. -->
  <Target Name="RemoveGameProcessMonoProvider" AfterTargets="_GenerateJavaStubs">
    <Exec Command="sed -i -E '/MonoRuntimeProvider_[0-9]+.*android:process=&quot;:game&quot;/d' &quot;$(IntermediateOutputPath)AndroidManifest.xml&quot;" />
  </Target>

  <Target Name="CheckNatives" BeforeTargets="PrepareForBuild" Condition="!Exists('$(NativesDir)java/sdl3.jar')">
    <Error Text="Android native libraries missing. Run Robust.Client.Android/natives/build-natives.sh first." />
  </Target>
</Project>
