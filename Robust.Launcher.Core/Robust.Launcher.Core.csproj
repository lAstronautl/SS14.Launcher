<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Platform-independent launcher logic (server hub, accounts, content download).
    Used by the Android launcher (Robust.Client.Android); kept free of Android APIs so it can be tested on desktop.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Robust.LoaderApi\Robust.LoaderApi\Robust.LoaderApi.csproj" />
  </ItemGroup>
</Project>
